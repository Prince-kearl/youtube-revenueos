# Supabase (server). SUPABASE_ANON_KEY accepts the project's publishable key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Supabase (browser — safe to expose, injected via Vite's VITE_* handling)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Google / YouTube OAuth. GOOGLE_REDIRECT_URI is the sole authoritative source for the OAuth
# redirect URI — the app never derives it from the incoming request's host/origin. Set a distinct
# value per environment (this local one, and a separate Vercel Production value), and register the
# exact same value under that Google OAuth client's Authorized redirect URIs.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=server-only-google-client-secret
# 8080 is this project's actual `npm run dev` port (see vite.config.ts's sandbox detection), not
# Vite's plain default of 5173 — adjust if your local dev server logs a different port.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/youtube/callback
GOOGLE_ANALYTICS_REDIRECT_URI=http://localhost:8080/api/integrations/google-analytics/callback

# AI (server-only; configure one provider in Vercel and local server environments)
# AI_PROVIDER=openrouter, openai, or anthropic. If omitted, the first configured provider is
# selected, checked in that same order — OpenRouter first since it's the default/primary provider.
AI_PROVIDER=openrouter
# OpenRouter (https://openrouter.ai) — OpenAI-compatible /chat/completions API, used for the
# Analyze Video feature. OPENROUTER_API_KEY must never be exposed to the browser (no VITE_ prefix).
# openrouter/free proved unreliable for Analyze Video's real workload in testing (small free
# reasoning model, intermittently returned non-JSON or empty content) — gpt-4o-mini via
# OpenRouter is the tested, reliable default; override per environment without any code change.
OPENROUTER_API_KEY=server-only-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional OpenRouter-compatible endpoint override.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=server-only-openai-key
OPENAI_MODEL=gpt-5-mini
# Optional OpenAI-compatible endpoint override for an approved gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=server-only-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional Anthropic-compatible endpoint override for an approved gateway.
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Jobs
UPSTASH_REDIS_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_TOKEN=server-only-upstash-token

# Billing and email
STRIPE_SECRET_KEY=server-only-stripe-secret
STRIPE_WEBHOOK_SECRET=server-only-stripe-webhook-secret
STRIPE_CONNECT_CLIENT_ID=server-only-stripe-connect-client-id
STRIPE_CONNECT_REDIRECT_URI=http://localhost:8080/api/integrations/stripe/callback
KIT_CLIENT_ID=server-only-kit-client-id
KIT_CLIENT_SECRET=server-only-kit-client-secret
KIT_REDIRECT_URI=http://localhost:8080/api/integrations/kit/callback
RESEND_API_KEY=server-only-resend-key

# Application
# Local dev shown below. Production (Vercel) currently uses https://youtube-revenueos.vercel.app
# — GOOGLE_REDIRECT_URI above must be updated to match APP_URL in each environment.
APP_URL=http://localhost:5173
# 32 random bytes, base64-encoded (openssl rand -base64 32). Never share or commit the real value.
TOKEN_ENCRYPTION_KEY=32-byte-server-only-key-base64
